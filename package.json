{
  "name": "mywebsite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"--no-deprecation\" next dev --turbopack",
    "dev:chrome": "concurrently \"npm run dev\" \"node scripts/open-browser.js\"",
    "build": "NODE_OPTIONS=\"--no-deprecation\" next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.0.2",
    "@contentful/rich-text-types": "^17.0.1",
    "contentful": "^11.7.2",
    "contentful-management": "^11.53.0",
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@netlify/plugin-nextjs": "^5.11.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
